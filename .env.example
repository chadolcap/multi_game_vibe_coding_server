# 설정 예시 파일 — 이 파일을 복사해서 .env 를 만든다.
# .env 는 Git 에 올리지 않는다. 이 예시 파일에는 실제 비밀번호/계정 정보를 넣지 않는다.

# 채널 포트 (채널 번호는 1부터)
WATCHER_PORT=6000
LOBBY_PORTS=6011,6012
GAME_PORTS=6021,6022,6023

# wss(TLS) — 운영 환경은 반드시 true. 개발 환경에서만 false(ws)
USE_TLS=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6780

# MySQL — XAMPP 기본 root 계정은 비밀번호가 없다 (DB_PASSWORD= 로 비워 둠)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rps_game
